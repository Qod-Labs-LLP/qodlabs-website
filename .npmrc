# The template's devDependencies have a pre-existing peer-dep conflict
# (@typescript-eslint/eslint-plugin@7 wants parser ^6, but parser is 7).
# These are lint-only and unused at build time (next.config sets
# eslint.ignoreDuringBuilds), but `npm ci` still validates the whole tree.
# legacy-peer-deps makes every environment install the same way the lockfile
# was generated — including Cloudflare Workers Builds, which runs `npm ci`
# without flags.
legacy-peer-deps=true
